# ── Site ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Offline development: no provider calls (naive cut-out + template copy). Never in production.
PIPELINE_MOCK=1
STUDIO_GATE=on                            # off disables the studio-quality check (not recommended)

# ── Background removal ────────────────────────────────────────────
REMBG_URL=http://localhost:5001           # services/rembg
REMBG_TOKEN=                              # shared secret, if the service sets one
REMBG_MODEL=isnet-general-use             # or u2net; must be allowed by the service (REMBG_MODELS)
REMBG_POST_PROCESS=1                      # smooth the mask edge (recommended)
OUTPUT_MAX_SIZE=2000                      # square output, px
STABILITY_API_KEY=                        # cloud fallback + optional upscale
ENHANCE_DARK_PRODUCTS=0                   # 1 = Stability upscale for dark products
AI_RETOUCH=on                             # with STABILITY_API_KEY: AI repaints tape marks (off = local fill)

# ── Copy (vision-language model) ──────────────────────────────────
COPY_PROVIDER=openai                      # openai (default) | anthropic | mock
OPENAI_API_KEY=                           # platform.openai.com → API keys
OPENAI_MODEL=gpt-6.2-sol                  # gpt-4o and newer also work
ANTHROPIC_API_KEY=                        # optional alternative (COPY_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-opus-5-5

# ── Storage ───────────────────────────────────────────────────────
# Production: Vercel Blob (public store) for images + the Upstash Redis below for runs and drafts.
BLOB_READ_WRITE_TOKEN=                    # set automatically when the Blob store is connected to the project
# Alternative: Supabase (used only when BLOB_READ_WRITE_TOKEN is empty; run supabase/schema.sql once)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=                # server only; never NEXT_PUBLIC_

# ── Guardrails ────────────────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=                          # required in production: openssl rand -hex 16
TRUST_CLOUDFLARE=0                        # 1 only if the origin accepts traffic from Cloudflare alone
MAX_RUNS_PER_IP_PER_DAY=2
DAILY_SPEND_CAP_USD=0.15                  # all visitors together; live runs close for the rest of the UTC day
# Per-stage estimates reserved against the cap (prices as of Nov 2026; see lib/config.ts).
EST_COST_BACKGROUND_USD=0.05             # Stability Remove Background, only when the rembg service is down
EST_COST_ENHANCE_USD=0.02                # Stability Fast Upscaler (dark products)
EST_COST_COPY_USD=0.012                  # one gpt-6.2-sol call, measured ≈ $0.011
EST_COST_RETOUCH_USD=0.05                # Stability Inpaint
WATERMARK_TEXT=AI DEMO · not for commercial use

# ── CMS publishing ─────────────────────────────────────────────────
# The built-in demo store (/store) works without any of this. Real stores are owner-only:
# locally always, on a deployment with PUBLISH_TOKEN (entered once on a result page).
PUBLISH_TOKEN=

# Daily clean-up (GET /api/purge, scheduled in vercel.json). Vercel sends it as a Bearer token.
# Visitors' live runs + images are deleted after RETENTION_DAYS, their demo-store drafts after DRAFT_RETENTION_DAYS.
CRON_SECRET=                               # openssl rand -hex 24
RETENTION_DAYS=30
DRAFT_RETENTION_DAYS=7
SHOPIFY_STORE_DOMAIN=                     # your-store.myshopify.com (created in the Dev Dashboard)
SHOPIFY_CLIENT_ID=                        # Dev Dashboard → your app → Settings
SHOPIFY_CLIENT_SECRET=                    # same page; scopes write_products + write_files
# SHOPIFY_ADMIN_TOKEN=                    # only for a legacy custom app with a fixed token
SHOPIFY_API_VERSION=2025-01
WOO_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
WOO_WP_USER=                              # for image upload to the media library
WOO_WP_APP_PASSWORD=                      # WordPress → Users → Application passwords
CMS_WEBHOOK_URL=                          # any other CMS: signed JSON POST
CMS_WEBHOOK_SECRET=
